# Local deployment state and generated operational configuration can contain
# capabilities or selector credentials. They are never source-controlled.
/state/
/backups/
.env
.env.*
*.env

# The maintainer's Surge profile, kept next to the checkout; it holds proxy
# credentials.
/FireTunnel.conf

# Local build and test outputs.
/bin/
/build/
/dist/
/tmp/
.coverage/
coverage.out
*.coverprofile
*.log
__pycache__/

# JavaScript dependencies and generated frontend assets.
/node_modules/
/web/node_modules/
/internal/web/static/*
!/internal/web/static/.gitkeep

# Editor, agent, and operating-system files.
.DS_Store
.idea/
.vscode/
.claude/
